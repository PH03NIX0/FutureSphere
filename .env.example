# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase — public web config (safe in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional public app origin for magic-link continue URL (defaults to window.location.origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app

# Firebase Admin — server only (never commit real values)
# Local: put these in .env.local. Hosts (Vercel/Netlify) do NOT read .env.local —
# add the same keys in the host dashboard, then redeploy.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the PEM as a single line with \n for newlines, wrapped in quotes:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional: more reliable on Vercel/Netlify. Base64-encode the PEM (including newlines).
# FIREBASE_ADMIN_PRIVATE_KEY_BASE64=

# App Check (added in a later stage)
# NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# FIREBASE_APP_CHECK_DEBUG_TOKEN=
